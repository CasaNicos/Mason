{
  "name": "mason-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Mason React Bits bundle: builds window.MasonUI into ../static/ui/ (spec: docs/ui/REACT_BITS_BUNDLE_DESIGN.md)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/check-src.mjs && eslint . && vite build && node scripts/budget.mjs",
    "build:check": "node scripts/build-twice.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "check:src": "node scripts/check-src.mjs",
    "rb:diff": "node scripts/rb-diff.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "gsap": "3.15.0",
    "motion": "13.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "jsdom": "29.1.1",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
